+def framebase_targets_with_deleted(library: PhotoLibrary, photo_album: PhotoAlbum, requested: Mapping[str, Mapping[str, Any]]) -> Iterable[PhotoAsset]:
+    """Confirm exact trash assets before considering any active-library mutation."""
+    pending = dict(requested)
+    started = time.monotonic()
+    recent = library.recently_deleted
+    recent_count = len(recent)
+    if recent_count > 0:
+        trash_targets = {key: {field: value for field, value in asset.items() if field != "lookupRank"} for key, asset in pending.items()}
+        for photo in framebase_target_photos(recent, trash_targets, max_scan=recent_count + 100, max_seconds=20):
+            pending.pop(str(photo.id), None)
+            photo.framebase_already_deleted = True
+            yield photo
+    if not pending:
+        return
+    if getattr(library, "framebase_indexing_state", None) == "RUNNING":
+        error = PyiCloudServiceNotActivatedException("Apple iCloud Photo Library has not finished indexing yet", None)
+        error.indexing_state = "RUNNING"
+        error.indexing_zone = library.zone_id.get("zoneName")
+        raise error
+    fallback_count = getattr(library, "framebase_read_probe_count", None)
+    remaining_seconds = max(0, 90 - (time.monotonic() - started)) if fallback_count is not None else None
+    yield from framebase_target_photos(photo_album, pending, max_scan=fallback_count + 100 if fallback_count is not None else None, max_seconds=remaining_seconds)

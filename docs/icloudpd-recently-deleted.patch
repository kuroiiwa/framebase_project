--- /dev/null
+++ b/tests/test_framebase_deleted_targets.py
@@ -0,0 +1,32 @@
+from unittest.mock import Mock, patch
+import pytest
+from icloudpd.base import framebase_targets_with_deleted
+from pyicloud_ipd.exceptions import PyiCloudServiceNotActivatedException
+
+
+def test_recently_deleted_target_never_reaches_active_scan():
+    library = Mock(framebase_indexing_state="RUNNING", zone_id={"zoneName": "PrimarySync"})
+    library.recently_deleted = [Mock(id="target")]
+    with patch("icloudpd.base.framebase_target_photos", return_value=iter(library.recently_deleted)) as scan:
+        items = list(framebase_targets_with_deleted(library, object(), {"target": {"lookupRank": 42}}))
+    assert len(items) == 1 and items[0].framebase_already_deleted is True
+    assert scan.call_count == 1
+    assert "lookupRank" not in scan.call_args.args[1]["target"]
+
+
+def test_running_index_blocks_unconfirmed_active_targets():
+    library = Mock(framebase_indexing_state="RUNNING", zone_id={"zoneName": "PrimarySync"})
+    library.recently_deleted = []
+    with patch("icloudpd.base.framebase_target_photos") as scan:
+        with pytest.raises(PyiCloudServiceNotActivatedException):
+            list(framebase_targets_with_deleted(library, object(), {"target": {}}))
+    scan.assert_not_called()
+
+
+def test_finished_index_can_search_active_assets_after_empty_trash():
+    class Library:
+        recently_deleted = []
+    with patch("icloudpd.base.framebase_target_photos", return_value=iter([Mock(id="active")])) as scan:
+        items = list(framebase_targets_with_deleted(Library(), object(), {"active": {}}))
+    assert len(items) == 1
+    assert scan.call_args.args[1] == {"active": {}}

+class FrameBaseTargetScanTestCase(TestCase):
+    def test_stops_before_reading_next_page_after_all_targets_found(self):
+        class Album:
+            offset = 0
+            def __iter__(self):
+                yield Mock(id="target")
+                raise AssertionError("must not continue the whole-library scan")
+        self.assertEqual([photo.id for photo in framebase_target_photos(Album(), {"target": {}})], ["target"])
+
+    def test_reverse_scan_recovers_missing_forward_targets_without_duplicates(self):
+        class Album:
+            offset = 0
+            def __iter__(self):
+                yield Mock(id="first")
+                if os.environ.get("FRAMEBASE_DELETE_DIRECTION") == "DESCENDING":
+                    yield Mock(id="missing")
+                    raise AssertionError("must stop after final target")
+        actual = [photo.id for photo in framebase_target_photos(Album(), {"first": {}, "missing": {}})]
+        self.assertEqual(actual, ["first", "missing"])
+        self.assertNotIn("FRAMEBASE_DELETE_DIRECTION", os.environ)
+
+
+    def test_cached_rank_probes_target_window_without_scanning_from_start(self):
+        class Album:
+            offset = 0
+            def __iter__(self):
+                if self.offset != 1900:
+                    raise AssertionError("cached rank should skip earlier pages")
+                yield Mock(id="target")
+                raise AssertionError("stop immediately on exact target")
+        self.assertEqual([photo.id for photo in framebase_target_photos(Album(), {"target": {"lookupRank": 2000}})], ["target"])
+
+    def test_stale_cached_rank_falls_back_without_trusting_the_hint(self):
+        class Album:
+            offset = 0
+            def __iter__(self):
+                if self.offset == 1900:
+                    for index in range(300):
+                        yield Mock(id="wrong-" + str(index))
+                    raise AssertionError("probe must be bounded")
+                else:
+                    yield Mock(id="target")
+        self.assertEqual([photo.id for photo in framebase_target_photos(Album(), {"target": {"lookupRank": 2000}})], ["target"])

+def framebase_target_photos(photo_album: PhotoAlbum, requested: Mapping[str, Mapping[str, Any]]) -> Iterable[PhotoAsset]:
+    """Read only until exact targets are found; recover Apple pagination gaps in reverse."""
+    pending = set(requested)
+    scanned = 0
+    previous_direction = os.environ.get("FRAMEBASE_DELETE_DIRECTION")
+    try:
+        ranks = sorted({max(0, asset["lookupRank"] - 100) for asset in requested.values()
+                        if isinstance(asset.get("lookupRank"), int) and not isinstance(asset.get("lookupRank"), bool) and asset["lookupRank"] >= 0})
+        # Probe small windows around cached positions; shifted indexes must fall back.
+        probes = [("ASCENDING", rank, 300) for rank in ranks] if len(ranks) <= 4 else []
+        scans = probes + [("ASCENDING", 0, None), ("DESCENDING", 0, None)]
+        for direction, start_rank, limit in scans:
+            if not pending:
+                break
+            os.environ["FRAMEBASE_DELETE_DIRECTION"] = direction
+            photo_album.offset = start_rank
+            scan_label = "HINT" if limit is not None else direction
+            print("FRAMEBASE_DELETE_PROGRESS " + json.dumps({"scanned": scanned, "remaining": len(pending), "direction": scan_label}), flush=True)
+            for window_index, photo in enumerate(photo_album):
+                scanned += 1
+                if scanned % 100 == 0:
+                    print("FRAMEBASE_DELETE_PROGRESS " + json.dumps({"scanned": scanned, "remaining": len(pending), "direction": scan_label}), flush=True)
+                if str(photo.id) in pending:
+                    pending.remove(str(photo.id))
+                    yield photo
+                    if not pending:
+                        return
+                if limit is not None and window_index + 1 >= limit:
+                    break
+    finally:
+        if previous_direction is None:
+            os.environ.pop("FRAMEBASE_DELETE_DIRECTION", None)
+        else:
+            os.environ["FRAMEBASE_DELETE_DIRECTION"] = previous_direction
+

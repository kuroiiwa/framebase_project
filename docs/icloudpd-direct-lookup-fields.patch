+def test_explicit_fields_and_batch_response_avoid_pagination(capsys):
+    cloud = library([])
+    def respond(_url, **kwargs):
+        payload = json.loads(kwargs["data"])
+        assert "isDeleted" in payload["desiredKeys"]
+        return Mock(json=lambda: {"batch": [{"records": pair()}]})
+    cloud.session.post.side_effect = respond
+    with patch("icloudpd.base.framebase_target_photos") as scan:
+        assert len(list(framebase_targets_with_deleted(cloud, object(), {"target": {"lookupAssetRecordName": "asset-record"}}))) == 1
+    scan.assert_not_called()
+    assert '"matched": 1' in capsys.readouterr().out
+
+
+@pytest.mark.parametrize("reason,modify", [
+    ("deletion_state_missing_or_invalid", lambda records: records[1]["fields"].pop("isDeleted")),
+    ("expunged_or_unknown", lambda records: records[1]["fields"].update({"isExpunged": {"value": 1}})),
+    ("change_tag_missing", lambda records: records[1].pop("recordChangeTag")),
+])
+def test_incomplete_or_expunged_records_report_reason_without_authorizing_delete(reason, modify, capsys):
+    records = pair()
+    modify(records)
+    assert list(framebase_direct_targets(library(records), {"target": {"lookupAssetRecordName": "asset-record"}})) == []
+    assert reason in capsys.readouterr().out
+
+
+def test_partial_lookup_scans_only_remaining_targets(capsys):
+    cloud = library(pair())
+    requested = {"target": {"lookupAssetRecordName": "asset-record"}, "other": {"lookupAssetRecordName": "other-record"}}
+    with patch("icloudpd.base.framebase_target_photos", return_value=iter([Mock(id="other")])) as scan:
+        assert len(list(framebase_targets_with_deleted(cloud, object(), requested))) == 2
+    assert set(scan.call_args.args[1]) == {"other"}
+    assert "master_missing" in capsys.readouterr().out

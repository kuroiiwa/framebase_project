--- /dev/null
+++ b/tests/test_framebase_target_bounds.py
@@ -0,0 +1,40 @@
+from unittest.mock import Mock, patch
+from icloudpd.base import framebase_target_photos
+
+
+def test_five_nearby_hints_are_merged_instead_of_skipping_all_hints():
+    class Album:
+        offset = 0
+        def __iter__(self):
+            assert self.offset == 1900
+            for index in range(5):
+                yield Mock(id=str(index))
+            raise AssertionError("must stop after all exact targets")
+    requested = {str(i): {"lookupRank": 2000 + i} for i in range(5)}
+    assert len(list(framebase_target_photos(Album(), requested))) == 5
+
+
+def test_repeating_pages_are_bounded_in_both_directions(capsys):
+    reads = []
+    class Album:
+        offset = 0
+        def __iter__(self):
+            while True:
+                reads.append(1)
+                yield Mock(id="unrelated")
+    assert list(framebase_target_photos(Album(), {"target": {}}, max_scan=3)) == []
+    assert len(reads) == 6
+    output = capsys.readouterr().out
+    assert "ASCENDING" in output and "DESCENDING" in output
+    assert "HINT" not in output
+
+
+def test_time_limit_stops_lookup_and_returns_diagnostic(capsys):
+    class Album:
+        offset = 0
+        def __iter__(self):
+            yield Mock(id="unrelated")
+            raise AssertionError("time limit must stop")
+    with patch("icloudpd.base.time.monotonic", side_effect=[0, 91]):
+        assert list(framebase_target_photos(Album(), {"target": {}}, max_seconds=90)) == []
+    assert "FRAMEBASE_DELETE_LIMIT" in capsys.readouterr().out

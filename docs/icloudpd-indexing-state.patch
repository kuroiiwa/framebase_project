+import json
+from unittest.mock import Mock, patch
+import pytest
+from pyicloud_ipd.services.photos import PhotoLibrary
+from pyicloud_ipd.exceptions import PyiCloudServiceNotActivatedException
+from icloudpd.base import framebase_report_error
+
+@pytest.mark.parametrize("state,reason", [("RUNNING", "photos_indexing"), ("FAILED", "photos_indexing_failed")])
+def test_indexing_state_survives_diagnostic(state, reason, capsys):
+    session = Mock()
+    session.post.return_value.json.return_value = {"records": [{"fields": {"state": {"value": state}}}]}
+    with pytest.raises(PyiCloudServiceNotActivatedException) as raised:
+        PhotoLibrary("https://example.invalid", {}, session, {"zoneName": "PrimarySync"}, "private")
+    with patch.dict("os.environ", {"FRAMEBASE_VERIFY_SESSION": "1"}):
+        framebase_report_error(raised.value, "photos_error")
+    detail = json.loads(capsys.readouterr().out.split("FRAMEBASE_ERROR ")[1])
+    assert detail["reason"] == reason
+    assert detail["indexingState"] == state
+    assert detail["zoneName"] == "PrimarySync"
+
+def test_finished_index_is_ready():
+    session = Mock()
+    session.post.return_value.json.return_value = {"records": [{"fields": {"state": {"value": "FINISHED"}}}]}
+    PhotoLibrary("https://example.invalid", {}, session, {"zoneName": "PrimarySync"}, "private")
